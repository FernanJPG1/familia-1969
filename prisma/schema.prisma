// Prisma Schema for B2B Barbershop SaaS
// Compatible with SQLite for local zero-config execution and PostgreSQL/MySQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  phone             String?
  address           String?
  timezone          String             @default("America/Bogota")
  slotBufferMinutes Int                @default(10) @map("slot_buffer_minutes")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  barbers           Barber[]
  services          Service[]
  clients           Client[]
  appointments      Appointment[]
  whatsappSessions  WhatsAppSession[]

  @@map("tenants")
}

model Barber {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  name                 String
  phone                String?
  colorTag             String            @default("#3B82F6") @map("color_tag")
  commissionPercentage Float             @default(0.0) @map("commission_percentage")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules            BarberSchedule[]
  blocks               ScheduleBlock[]
  appointments         Appointment[]

  @@index([tenantId, isActive])
  @@map("barbers")
}

model Service {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  name            String
  durationMinutes Int           @map("duration_minutes")
  price           Float
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([tenantId, isActive])
  @@map("services")
}

model Client {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  name          String
  whatsappPhone String        @map("whatsapp_phone")
  totalNoShows  Int           @default(0) @map("total_no_shows")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@unique([tenantId, whatsappPhone])
  @@index([tenantId, whatsappPhone])
  @@map("clients")
}

model BarberSchedule {
  id        String   @id @default(uuid())
  barberId  String   @map("barber_id")
  dayOfWeek Int      @map("day_of_week") // 1 = Monday ... 7 = Sunday
  startTime String   @map("start_time") // HH:mm (e.g. "09:00")
  endTime   String   @map("end_time")   // HH:mm (e.g. "19:00")
  isActive  Boolean  @default(true) @map("is_active")

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek, isActive])
  @@map("barber_schedules")
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  barberId  String   @map("barber_id")
  date      String   // YYYY-MM-DD
  startTime String   @map("start_time") // HH:mm
  endTime   String   @map("end_time")   // HH:mm
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, date])
  @@map("schedule_blocks")
}

model Appointment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  barberId       String    @map("barber_id")
  clientId       String    @map("client_id")
  serviceId      String    @map("service_id")
  startTime      DateTime  @map("start_time")
  endTime        DateTime  @map("end_time")
  totalPrice     Float     @map("total_price")
  status         String    @default("confirmed") // pending, confirmed, completed, cancelled, no_show
  notes          String?
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber         Barber    @relation(fields: [barberId], references: [id], onDelete: Restrict)
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service        Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([barberId, startTime, endTime, status])
  @@index([tenantId, startTime, status])
  @@index([clientId])
  @@map("appointments")
}

model WhatsAppSession {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  whatsappPhone     String   @map("whatsapp_phone")
  currentStep       String   @default("IDLE") @map("current_step")
  contextData       String   @map("context_data") // JSON serialized object
  lastInteractionAt DateTime @default(now()) @map("last_interaction_at")
  expiresAt         DateTime @map("expires_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, whatsappPhone])
  @@index([tenantId, whatsappPhone, expiresAt])
  @@map("whatsapp_sessions")
}
